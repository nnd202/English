  "pastilles": {
    "flap": {
      "nom": "Flap T",
      "regle": "Entre deux voyelles (la seconde non accentuée), t se dit comme un d très bref : la langue tape une seule fois. water, city, get it."
    },
    "liaison": {
      "nom": "Liaison",
      "regle": "La consonne finale s'accroche à la voyelle du mot suivant : on entend un seul mot. turn off → tɝː‿nɑːf."
    },
    "faible": {
      "nom": "Forme faible",
      "regle": "Les petits mots non accentués (have, of, to, for, can, and, the…) perdent leur voyelle pleine et passent au schwa ə."
    },
    "reduction": {
      "nom": "Réduction",
      "regle": "Des groupes très fréquents fusionnent à l'oral : going to → gonna, want to → wanna, got to → gotta, let me → lemme. On l'écrit normalement, on l'entend réduit."
    },
    "elision": {
      "nom": "Élision",
      "regle": "Un son disparaît, souvent un t ou une syllabe faible coincés entre deux consonnes : next day, comfortable, don't know."
    },
    "assimilation": {
      "nom": "Assimilation",
      "regle": "Deux sons voisins se fondent en un troisième : d + you → dʒ (did you → didja), t + you → tʃ (got you → gotcha)."
    },
    "glotte": {
      "nom": "Coup de glotte",
      "regle": "Devant un n, ou en fin de mot devant une consonne, le t est coupé dans la gorge au lieu d'être articulé : button, certain, right now, that makes sense."
    },
    "ed": {
      "nom": "Terminaison -ed",
      "regle": "-ed se dit /t/ après un son sourd (p, k, f, s, ʃ, tʃ), /d/ après un son voisé, et /ɪd/ seulement après t ou d : asked /æskt/, changed /tʃeɪndʒd/, wanted /ˈwɑːn.t̬ɪd/."
    },
    "accent": {
      "nom": "Accent mobile",
      "regle": "L'accent tonique change de syllabe selon la forme du mot (nom ou verbe, dérivés), et les voyelles changent avec lui : record / record, photograph / photography."
    },
    "muet": {
      "nom": "Lettre muette",
      "regle": "L'orthographe garde une lettre qu'on ne prononce pas : debt, island, Wednesday, often."
    },
    "piege": {
      "nom": "Piège",
      "regle": "La prononciation s'éloigne de ce que l'orthographe laisse attendre : colonel, women, busy, recipe."
    }
  },
